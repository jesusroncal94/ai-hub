# AI Hub Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# SECURITY (REQUIRED FOR PRODUCTION)
# =============================================================================

# Admin password - MUST be set in production
# If not set, a random password will be generated and printed to stderr
AI_HUB_ADMIN_PASSWORD=your-secure-password-here

# =============================================================================
# SERVER
# =============================================================================

# Host to bind to (use 0.0.0.0 for external access behind a reverse proxy)
AI_HUB_HOST=127.0.0.1

# Port to listen on
AI_HUB_PORT=7860

# =============================================================================
# STORAGE
# =============================================================================

# Data directory for database and uploads
AI_HUB_DATA_DIR=.data

# Maximum upload file size in MB
AI_HUB_MAX_UPLOAD_MB=50

# =============================================================================
# AI MODELS
# =============================================================================

# Default model (sonnet, opus, haiku)
AI_HUB_DEFAULT_MODEL=sonnet

# Whisper model for voice transcription (base, small, medium, large)
AI_HUB_WHISPER_MODEL=base

# =============================================================================
# RATE LIMITING
# =============================================================================

# Maximum failed login attempts before lockout
AI_HUB_MAX_LOGIN_ATTEMPTS=5

# Time window for counting attempts (seconds)
AI_HUB_LOGIN_WINDOW_SECONDS=300

# Lockout duration after max attempts (seconds)
AI_HUB_LOCKOUT_SECONDS=900
